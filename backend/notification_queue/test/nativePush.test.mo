import Native "../src/nativePush";
import Principal "mo:core/Principal";
import Array "mo:core/Array";
import Nat "mo:core/Nat";
let worker = Principal.fromText("aaaaa-aa");
let other = Principal.fromText("2vxsx-fae");
let attempt : Native.Attempt = { receipt = "1"; notification_id = "n"; user = "u"; token = "t"; platform = "android"; device_stamp = 1; worker; status = "sending" };
assert Native.occupied([attempt], "n", "t", 1);
assert Native.occupied([attempt], "n", "t", 2);
assert not Native.occupied([attempt], "other", "t", 1);
assert Native.canSettle(attempt, worker, "accepted");
assert not Native.canSettle(attempt, other, "accepted");
assert not Native.canSettle(attempt, worker, "retry");
assert Native.canSettle({ attempt with status = "held" }, worker, "held");
assert not Native.canSettle({ attempt with status = "held" }, worker, "accepted");
func expired(_ : Text) : Bool { true };
func current(_ : Text) : Bool { false };
assert Native.retain(attempt, expired);
assert Native.retain({ attempt with status = "held" }, expired);
assert Native.retain({ attempt with status = "stopped" }, expired);
assert Native.retain({ attempt with status = "accepted" }, current);
assert not Native.retain({ attempt with status = "accepted" }, expired);
assert not Native.retain({ attempt with status = "inactive" }, expired);
assert Native.unresolved(attempt);
assert Native.unresolved({ attempt with status = "held" });
assert not Native.unresolved({ attempt with status = "accepted" });
let historical = Array.tabulate<Native.Attempt>(10_001, func(i) = { attempt with receipt = i.toText(); status = "accepted" });
assert historical.filter(Native.unresolved).size() == 0;
assert historical.filter(func a = Native.retain(a, expired)).size() == 0;
assert historical.concat([{ attempt with status = "held" }]).filter(func a = Native.retain(a, expired)).size() == 1;